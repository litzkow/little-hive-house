rules_version = '2';
// Customer photos: uploads/{uid}/{packId}/{n}.{jpg|png|heic|webp}
// Only the signed-in owner (anonymous guests too) may upload, images only, up to 25 MB. Admins may read and delete.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }

    match /uploads/{uid}/{packId}/{fileName} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && packId.matches('[A-Za-z0-9_-]{1,64}')
        && fileName.matches('[0-9]{1,3}[.]([jJ][pP][eE]?[gG]|[pP][nN][gG]|[hH][eE][iI][cCfF]|[wW][eE][bB][pP])')
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
