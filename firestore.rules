rules_version = '2';
// Little Hive House. Clients only read; every write except a user's own profile goes through Cloud Functions
// (the Admin SDK ignores these rules). Admin = custom claim admin:true (callable claimAdmin).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function notAnonymous() { return request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function validProfile(d) {
      return (!('name' in d) || (d.name is string && d.name.size() <= 80))
        && (!('marketing' in d) || d.marketing is bool)
        && (!('favorites' in d) || (d.favorites is list && d.favorites.size() <= 600));
    }

    // users/{uid}: the owner may write only name, marketing and favorites; welcome() fills in the rest.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && notAnonymous()
        && request.resource.data.keys().hasOnly(['name', 'marketing', 'favorites'])
        && validProfile(request.resource.data);
      allow update: if isOwner(uid) && notAnonymous()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'marketing', 'favorites'])
        && validProfile(request.resource.data);
      allow delete: if false;
    }

    // orders: admins only. The stored order holds admin notes, Stripe fees, label costs and photo paths, so customers
    // never read it directly: they call myOrders() / myOrder({id}) / trackOrder(), which return a whitelisted view.
    // Only Cloud Functions write.
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // reviews: published ones are public (query where('status', '==', 'published')); admins see all.
    match /reviews/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if false;
    }

    // admin-only reading; written by Cloud Functions
    match /settings/{id} { allow read: if isAdmin(); allow write: if false; }
    match /quotes/{id} { allow read: if isAdmin(); allow write: if false; }
    match /messages/{id} { allow read: if isAdmin(); allow write: if false; }
    match /subscribers/{id} { allow read: if isAdmin(); allow write: if false; }

    // server-only: meta/counters, stripeEvents, rateLimits and anything else
    match /{document=**} { allow read, write: if false; }
  }
}
